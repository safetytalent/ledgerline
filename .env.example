# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database (Prisma — Supabase connection string)
DATABASE_URL=

# QuickBooks Online (sandbox app credentials from developer.intuit.com)
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=http://localhost:3000/api/qbo/callback
QBO_ENVIRONMENT=sandbox

# From Intuit developer dashboard > your app > Webhooks tab (separate
# from CLIENT_SECRET -- this is the "Verifier Token" Intuit shows you
# once you enable webhooks for the app)
QBO_WEBHOOK_VERIFIER_TOKEN=

# Encrypts QBO tokens at rest and signs the OAuth state param.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep this identical across all deployed instances -- rotating it
# invalidates every stored QBO connection (clients would need to
# reconnect).
ENCRYPTION_KEY=

# Confidence threshold for auto-post (0-100), start conservative
AUTO_POST_CONFIDENCE_THRESHOLD=85
