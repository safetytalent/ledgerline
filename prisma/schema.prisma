generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Firm {
  id        String     @id @default(cuid())
  name      String
  locations Location[]
  createdAt DateTime   @default(now())
}

model Location {
  id        String         @id @default(cuid())
  firm      Firm           @relation(fields: [firmId], references: [id])
  firmId    String
  name      String   // e.g. "Houston TX3"
  territory String?
  clients   Client[]
  users     UserLocation[]
  createdAt DateTime       @default(now())
}

// Maps a Supabase auth user (auth.uid()) to the location they work at.
// This is what prisma/sql/rls_policies.sql checks against — without a
// row here, a user can see nothing, which is the safe default.
model UserLocation {
  id         String   @id @default(cuid())
  userId     String   // Supabase auth.users.id — not a local FK, lives in a different schema
  location   Location @relation(fields: [locationId], references: [id])
  locationId String
  role       String   @default("staff") // "staff" | "manager" | "owner"
  createdAt  DateTime @default(now())

  @@unique([userId, locationId])
}

model Client {
  id            String                @id @default(cuid())
  location      Location              @relation(fields: [locationId], references: [id])
  locationId    String
  name          String
  qboRealmId    String?               // QuickBooks company connection id
  qboTokens     QboConnection?
  subscription  Subscription?
  transactions  Transaction[]
  corrections   CorrectionMemory[]
  closeTasks    CloseTask[]
  documents     Document[]
  // Which of the firm's service lines this client is signed up for —
  // values come from lib/services.ts (the 50-item service catalog).
  // Only "Monthly Bookkeeping" is software-automated today (the
  // transaction review queue); the rest are tracked here so staff can
  // see and manage the full client relationship in one place, even
  // before each service gets its own dedicated workflow built out.
  activeServices String[]             @default([])
  // Entity type drives which tax documents are required and whether
  // K-1s apply at all — K-1s only exist for S-corps and partnerships,
  // never C-corps or sole props. Nullable until staff sets it.
  entityType    EntityType?
  owners        ClientOwner[]
  taxReturnDrafts TaxReturnDraft[]
  createdAt     DateTime              @default(now())
}

enum EntityType {
  S_CORP
  C_CORP
  PARTNERSHIP
  SOLE_PROP
  INDIVIDUAL
}

// Shareholders (S-corp) or partners (partnership) and their ownership
// share — this is what determines how many K-1s are needed and how
// income is split between them. Not used for C-corp or sole prop.
model ClientOwner {
  id                String   @id @default(cuid())
  client            Client   @relation(fields: [clientId], references: [id])
  clientId          String
  name              String
  ownershipPercent  Decimal
  createdAt         DateTime @default(now())
}

// Tracks whether a client is a paying subscriber. One row per client,
// kept in sync with Stripe via the webhook in
// app/api/billing/webhook/route.ts — never trust the frontend's idea
// of subscription status, only what Stripe confirms.
model Subscription {
  id                   String   @id @default(cuid())
  client               Client   @relation(fields: [clientId], references: [id])
  clientId             String   @unique
  stripeCustomerId     String   @unique
  stripeSubscriptionId String?  @unique
  status               String   // mirrors Stripe's status: "active", "past_due", "canceled", etc.
  currentPeriodEnd     DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model QboConnection {
  id           String   @id @default(cuid())
  client       Client   @relation(fields: [clientId], references: [id])
  clientId     String   @unique
  accessToken  String   // store encrypted at rest
  refreshToken String   // store encrypted at rest
  expiresAt    DateTime
}

model Transaction {
  id              String       @id @default(cuid())
  client          Client       @relation(fields: [clientId], references: [id])
  clientId        String
  qboTxnId        String       @unique
  vendorName      String
  amount          Decimal
  txnDate         DateTime
  // Phase E: which side of the P&L this belongs to. Purchase/Bill are
  // always EXPENSE; Deposit/Invoice/SalesReceipt are always INCOME.
  // Defaults to EXPENSE for backward compatibility — every row that
  // existed before this field was added came from Purchase/Bill only.
  txnType         TxnType      @default(EXPENSE)
  suggestedCategory String?
  confidenceScore Int          @default(0) // 0-100 — Phase A spec field name
  reasoning       String?      // human-readable explanation shown in the UI
  reviewStatus    ReviewStatus @default(PENDING_REVIEW)
  // Not part of the Phase A spec's 4-value enum — kept separate because
  // "escalated to client for clarification" is a real, distinct state
  // the existing Agent Activity feed depends on, and collapsing it into
  // pending_review would silently lose that information.
  escalatedToClient Boolean    @default(false)
  finalCategory   String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @default(now()) @updatedAt
}

enum TxnType {
  INCOME
  EXPENSE
}

enum ReviewStatus {
  AUTO_POSTED
  PENDING_REVIEW
  APPROVED
  REJECTED
}

// The per-client "learning" table — corrections feed future confidence
model CorrectionMemory {
  id              String   @id @default(cuid())
  client          Client   @relation(fields: [clientId], references: [id])
  clientId        String
  vendorName      String
  correctCategory String
  jobOrCostCode   String?
  timesConfirmed  Int      @default(1)
  lastUsedAt      DateTime @default(now())

  @@unique([clientId, vendorName])
}

// Stubbed for Phase 4 — not built out yet, schema reserved
model RoyaltyReport {
  id         String   @id @default(cuid())
  locationId String
  periodEnd  DateTime
  revenue    Decimal
  royaltyDue Decimal
  reportedAt DateTime @default(now())
}

// Monthly close checklist per client — tasks pulled directly from the
// firm's "Monthly Financial Close" service line. One row per
// (client, month, task).
model CloseTask {
  id        String   @id @default(cuid())
  client    Client   @relation(fields: [clientId], references: [id])
  clientId  String
  month     String   // "2026-09" format
  taskLabel String
  done      Boolean  @default(false)
  doneAt    DateTime?

  @@unique([clientId, month, taskLabel])
}

// Real uploaded files, stored in Supabase Storage under the
// "documents" bucket. This row just tracks metadata — the actual
// file bytes live in Storage at `storagePath`.
model Document {
  id          String   @id @default(cuid())
  client      Client   @relation(fields: [clientId], references: [id])
  clientId    String
  fileName    String
  storagePath String
  // Tags this file as a specific required document (e.g. "Profit & Loss",
  // "Form 940") so the tax prep checklist can match uploads against
  // what's still missing. Null means "uploaded but not yet categorized."
  docType     String?
  uploadedAt  DateTime @default(now())
}

// Phase A: logs every action that required a human's explicit
// approval — posting, e-signing, or e-filing. This is the audit
// trail that proves a named human approved before anything final
// happened; nothing in this system bypasses writing a row here.
model Approval {
  id         String       @id @default(cuid())
  userId     String       // Supabase auth.users.id of the approving human
  actionType ActionType
  recordId   String       // id of the Transaction/Document/etc. being approved
  sessionRef String?      // session or IP reference, for the audit trail
  createdAt  DateTime     @default(now())
}

enum ActionType {
  POST
  ESIGN
  EFILE
  // Phase F: a credentialed preparer's internal sign-off on a draft
  // return — distinct from ESIGN, which is reserved for the client's
  // own signature (Phase J/K). Keeping these separate means the audit
  // trail never conflates "staff reviewed this" with "the client
  // actually signed it."
  PREPARER_REVIEW
}

// Phase A: every correction a human makes in the review queue writes
// here — a full history, distinct from CorrectionMemory (which only
// keeps the current best guess per vendor). This is the raw material
// the CEO/Operations Agent later summarizes into proposed rule
// changes — it never edits anything itself.
model LearningLog {
  id         String   @id @default(cuid())
  userId     String   // who made the correction
  recordId   String   // id of the Transaction being corrected
  fromValue  String?  // what it was before
  toValue    String?  // what it was corrected to
  reasonCode String?  // e.g. "wrong_category", "wrong_vendor_match"
  createdAt  DateTime @default(now())
}

// Phase F: a draft return's key totals, computed from approved,
// reconciled financials for one client/tax year. This is a workpaper
// summary, not an actual IRS form — real form generation belongs to
// the Document & Forms Library (Phase H onward).
//
// Rule 1 hard gate: a draft can NEVER be marked PREPARER_APPROVED
// except through recordPreparerSignoff() in actions.ts, which
// requires a named preparer and records who/when. There is no other
// code path that writes this status — the gate is enforced in the
// server action itself, not hidden behind a disabled button.
model TaxReturnDraft {
  id                  String           @id @default(cuid())
  client              Client           @relation(fields: [clientId], references: [id])
  clientId            String
  taxYear             String           // "2025"
  totalIncome         Decimal
  totalExpenses       Decimal
  netIncome           Decimal
  status              DraftStatus      @default(DRAFT)
  // Set only by recordPreparerSignoff() — the Rule 1 gate. Filing
  // itself (Phase K) requires this to already be non-null before it
  // will let a form move toward the client e-signature step.
  preparerApprovedBy  String?
  preparerApprovedAt  DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @default(now()) @updatedAt

  @@unique([clientId, taxYear])
}

enum DraftStatus {
  DRAFT
  PREPARER_APPROVED
}
